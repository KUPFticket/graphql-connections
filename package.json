{
  "name": "@kupfticket/graphql-connections",
  "version": "10.0.3",
  "description": "Build and handle Relay-like GraphQL connections using a Knex query builder",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev:mysql": "nodemon -e ts -w ./dev -x npm run ts-node-start:mysql",
    "ts-node-start:mysql": "node ./node_modules/.bin/ts-node -r tsconfig-paths/register dev/dev.mysql.ts",
    "clean": "rm -rf dist",
    "test": "rimraf ./db/test.sqlite3 && NODE_ENV=test npm run migrate:sqlite:latest && NODE_ENV=test npm run seed:sqlite:run && jest",
    "test:watch": "npm run test -- --watchAll --runInBand",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "build": "npm run clean && rollup -c",
    "watch": "rollup -cw",
    "lint": "biome lint --write",
    "prettier": "biome format --write",
    "knex:mysql": "node ./node_modules/.bin/ts-node ./node_modules/.bin/knex --knexfile knexfile.mysql.ts",
    "seed:mysql:make": "npm run knex:mysql -- -x ts seed:make",
    "seed:mysql:run": "npm run knex:mysql seed:run",
    "migrate:mysql:make": "npm run knex:mysql migrate:make",
    "migrate:mysql:latest": "npm run knex:mysql migrate:latest",
    "migrate:mysql:rollback": "npm run knex:mysql migrate:rollback",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KUPFticket/graphql-connections.git"
  },
  "resolutions": {
    "@types/mime": "3.0.4"
  },
  "keywords": [
    "GraphQL",
    "Connections",
    "Cursor",
    "Pagination",
    "Filtering",
    "Searching",
    "Filter",
    "Relay Connection"
  ],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/KUPFticket/graphql-connections/issues"
  },
  "homepage": "https://github.com/KUPFticket/graphql-connections#readme",
  "dependencies": {
    "graphql": "16.11.0",
    "knex": "3.1.0",
    "luxon": "3.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tsconfig/node22": "^22.0.1",
    "@types/dotenv": "^8.2.3",
    "@types/faker": "^6.6.11",
    "@types/jest": "^29.5.14",
    "@types/luxon": "3.6.2",
    "@types/node": "^22.15.3",
    "@types/superagent": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "apollo-server-koa": "^3.13.0",
    "dotenv": "^16.5.0",
    "faker": "^6.6.6",
    "jest": "^29.7.0",
    "koa": "^3.0.0",
    "lefthook": "^1.11.12",
    "mysql2": "3.14.1",
    "nodemon": "^3.1.10",
    "release-it": "^19.0.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.40.1",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "5.8.3"
  },
  "packageManager": "yarn@4.7.0"
}
